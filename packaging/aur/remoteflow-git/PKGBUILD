# Maintainer: 9M2PJU <9m2pju@hamradio.my>
pkgname=remoteflow-git
_pkgname=remoteflow
pkgver=1.15.1.r0.g0000000
pkgrel=1
pkgdesc="Cross-platform SSH, SFTP and RDP connection manager with an encrypted vault (Tauri 2 + Rust + React)"
arch=('x86_64')
url="https://github.com/jacek-nikiel/RemoteFlow"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'openssl'
  'libx11'
  'dbus'
  'zlib'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'xdg-utils'
)
makedepends=(
  'git'
  'cargo'
  'nodejs'
  'npm'
  'pkgconf'
  'librsvg'
  'libayatana-appindicator'
  'xdotool'
)
optdepends=(
  'freerdp: Native embedded or external FreeRDP client'
  'xorg-xwayland: Embedded native FreeRDP session under Wayland'
  'which: Required for FreeRDP binary detection'
  'zenity: Native GTK file and folder picker dialog'
  'kdialog: Native KDE file and folder picker dialog'
  'wl-clipboard: Reliable system clipboard copying under Wayland'
  'xclip: Reliable system clipboard copying under X11'
  'openssh: SSH agent authentication'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-bin")
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_pkgname}"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.r%s.g%s" \
      "$(node -p "require('./package.json').version")" \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${srcdir}/${_pkgname}"
  export npm_config_cache="${srcdir}/npm-cache"
  npm ci --no-audit --no-fund

  cd src-tauri
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/${_pkgname}"
  export npm_config_cache="${srcdir}/npm-cache"
  npm run build

  cd src-tauri
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/${_pkgname}"
  node scripts/check-i18n.mjs

  cd src-tauri
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --lib
}

package() {
  cd "${srcdir}/${_pkgname}"

  # Main binary
  install -Dm755 "src-tauri/target/release/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

  # Icons
  install -Dm644 "src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/${_pkgname}.png"
  install -Dm644 "src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/${_pkgname}.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256@2x/apps/${_pkgname}.png"
  install -Dm644 "src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
  install -Dm644 "src-tauri/icons/icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${_pkgname}.svg"

  # Desktop entry
  install -dm755 "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/${_pkgname}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=RemoteFlow
Comment=SSH, SFTP and RDP connection manager
Exec=/usr/bin/remoteflow
Icon=remoteflow
Terminal=false
Categories=Development;Network;
StartupWMClass=remoteflow
EOF

  # License & docs
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/LINUX.md "${pkgdir}/usr/share/doc/${pkgname}/LINUX.md"
}
